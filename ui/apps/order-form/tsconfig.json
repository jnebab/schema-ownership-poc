{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "es2022",
      "dom"
    ],
    "paths": {
      "*": [
        "./@mf-types/*"
      ]
    }
  },
  "include": [
    "src",
    "@mf-types"
  ]
}
